# Copy this file to .env and fill in what you need.

PORT=3000
# The address people use to reach your site (used in emailed download links)
PUBLIC_URL=http://localhost:3000

# Gemini (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model. Leave empty to try gemini-flash-lite-latest, then 2.5 Flash-Lite, then Flash.
GEMINI_MODEL=
# Protect the free quota
AI_DAILY_LIMIT=400
AI_PER_IP_HOUR=30

# Admin page with download emails and IPs: /admin?key=YOUR_KEY
ADMIN_KEY=change-me-to-a-long-random-string

# Set to 1 when running behind Nginx, Cloudflare or a load balancer, so the real visitor IP is recorded
TRUST_PROXY=0

# Email the video link to people who download (optional). Gmail works with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nimantran Studio <hello@example.com>"
